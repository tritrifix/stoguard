# Copy this file to .env and fill in real values. Never commit .env.

# Credentials for the "db" service (docker-compose.yml reads these directly).
POSTGRES_USER=stoguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stoguard

# Must stay built from the three values above. "db" is the Postgres service
# hostname on the Docker network (not localhost).
# For host-side tooling (npm run dev, prisma CLI), create a .env.local with the
# same URL pointing at 127.0.0.1:5432 instead — it takes precedence there and
# is never read by docker compose.
DATABASE_URL=postgresql://stoguard:changeme@db:5432/stoguard

# Container timezone. Decides when "today" flips, and therefore the number of
# days left before an expiry date. Optional, defaults to Europe/Paris.
TZ=Europe/Paris

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# BOOTSTRAP value only, used on the very first startup to seed the
# Configuration table in the database — which becomes the sole source of
# truth from then on. Changing this variable afterwards (or removing it) has
# NO EFFECT: the password lives in the database and is changed from
# /parametres in the app itself. The app refuses to start only if the
# Configuration table is empty AND this is also empty (nothing to bootstrap
# from).
#
# scrypt hash of your login password — never store the password itself.
# Generate it with:
#   npm run auth:hash
# (or, without Node installed locally: `docker compose build app` once, then
# `docker compose run --rm --entrypoint npm app run auth:hash`)
AUTH_PASSWORD_HASH=

# Open Food Facts requires a User-Agent identifying the app and a contact,
# in the form "Stoguard/0.1 (ContactEmail)" — so they can reach out if usage
# looks abnormal. Optional: the app falls back to an example address and
# just logs a warning at startup if this is empty. Not a real secret, but
# still your own address — never a real one in this example file.
OFF_CONTACT_EMAIL=contact@example.com
