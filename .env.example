# Copy this file to .env and fill in real values. Never commit .env.

# Credentials for the "db" service (docker-compose.yml reads these directly).
POSTGRES_USER=stoguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stoguard

# Must stay built from the three values above. "db" is the Postgres service
# hostname on the Docker network (not localhost).
DATABASE_URL=postgresql://stoguard:changeme@db:5432/stoguard

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Argon2 hash of your login password — never store the password itself.
# You'll generate this with a small script once auth is wired up (later step).
AUTH_PASSWORD_HASH=
